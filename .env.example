# Single environment file: read both by docker compose (env_file on all services)
# and by the app when started from the host (pydantic-settings). Copy to .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=payment_gateway

# The database host is the service name in the compose network. To run the
# app/alembic from the host, the database is exposed on localhost:5433 — override
# the environment variable (env var takes precedence over .env) or change the line:
#DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/payment_gateway
DATABASE_URL=postgresql+asyncpg://postgres:postgres@database:5432/payment_gateway
APP_ENV=local
APP_PORT=8000
IS_DEBUG=True
API_KEY=local-dev-api-key
CALLBACK_SECRET=local-dev-callback-secret
# Fake provider (optional): manual — callbacks are sent by hand via
# POST /callbacks/payments; auto — the service sends callbacks to itself following
# the scenario from metadata.fake_scenario with a FAKE_CALLBACK_DELAY_SECONDS (>0) delay.
#FAKE_PROVIDER_MODE=manual
#SELF_BASE_URL=http://localhost:8000
#FAKE_CALLBACK_DELAY_SECONDS=1.0
# Number of uvicorn workers (optional, default 1). The variable is read by
# uvicorn itself (click-based CLI with auto_envvar_prefix="UVICORN"); the app does
# not need it. The default of 1 fits the "one worker per pod, scale with replicas"
# model; more than 1 only makes sense for local load-testing experiments.
#UVICORN_WORKERS=1
