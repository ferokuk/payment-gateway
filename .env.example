# Single environment file: read both by docker compose (env_file on all services)
# and by the app when started from the host (pydantic-settings). Copy to .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=payment_gateway

# The database host is the service name in the compose network. To run the
# app/alembic from the host, the database is exposed on localhost:5432 — override
# the environment variable (env var takes precedence over .env) or change the line:
#DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/payment_gateway
DATABASE_URL=postgresql+asyncpg://postgres:postgres@database:5432/payment_gateway
APP_ENV=local
APP_PORT=8000
IS_DEBUG=True
# Merchant registration and profile API runs separately on port 8001.
# Generate the three secrets using the setup command in README before starting.
MERCHANT_SERVICE_URL=http://localhost:8001
MERCHANT_ENCRYPTION_KEY=
MERCHANT_SERVICE_SECRET=
MERCHANT_SUPPORT_SECRET=
#MERCHANT_SESSION_TTL_SECONDS=3600
# API_KEY is no longer used for authentication; register through POST /merchants.
CALLBACK_SECRET=local-dev-callback-secret
# Fake provider (optional): manual — callbacks are sent by hand via
# POST /callbacks/payments; auto — the service sends callbacks to itself following
# the scenario from metadata.fake_scenario with a FAKE_CALLBACK_DELAY_SECONDS (>0) delay.
#FAKE_PROVIDER_MODE=manual
#SELF_BASE_URL=http://localhost:8000
#FAKE_CALLBACK_DELAY_SECONDS=1.0
# Reconciliation of old CREATED/PENDING/ERROR refunds (optional). Query the
# provider first; re-initiate only CREATED + confirmed ABSENT inside the
# deduplication window. Older CREATED + ABSENT closes as not accepted and
# releases the reservation. UNKNOWN/disputed outcomes keep the reservation.
# Every attempt persists its next check before network I/O. Retries double
# from RETRY_AFTER to RETRY_MAX; both must be positive and MAX >= AFTER.
#RECONCILE_INTERVAL_SECONDS=60
#RECONCILE_STUCK_AFTER_SECONDS=900
# Shared API/worker initiation deadline, measured from refund.created_at.
# API recovery past it returns 409 and holds the reservation for reconciliation.
# The old RECONCILE_GIVE_UP_AFTER_SECONDS name is accepted as a fallback alias.
#REFUND_INITIATION_MAX_AGE_SECONDS=72000
#RECONCILE_BATCH_SIZE=100
#RECONCILE_RETRY_AFTER_SECONDS=60
#RECONCILE_RETRY_MAX_SECONDS=3600
# Number of uvicorn workers (optional, default 1). The variable is read by
# uvicorn itself (click-based CLI with auto_envvar_prefix="UVICORN"); the app does
# not need it. The default of 1 fits the "one worker per pod, scale with replicas"
# model; more than 1 only makes sense for local load-testing experiments.
#UVICORN_WORKERS=1
